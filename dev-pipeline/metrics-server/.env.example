# HTTP 服务配置：生产环境建议将 NODE_ENV 设置为 production
PORT=3001
NODE_ENV=development

# 数据库配置：DB_PROVIDER 必须与 DATABASE_URL 的数据库类型一致
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsx_metrics

# 认证配置：JWT_SECRET 至少 32 个字符；SERVICE_API_KEYS 保存 keyId 对应的 SHA-256 和用途
JWT_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=opsx-metrics-server
JWT_AUDIENCE=opsx-metrics-api
SERVICE_API_KEYS={}
# 仅用于非生产迁移兼容；生产环境禁止原始 API_KEY
API_KEY=

# 仅本地开发：显式模拟个人开发者 ID；production 配置此项会拒绝启动
DEV_IMPERSONATE_DEVELOPER_ID=

# 指纹验真私钥：JSON key ring，值为 Base64 编码的 PKCS#8 PEM 私钥，禁止提交真实私钥
FINGERPRINT_PRIVATE_KEYS={"fp1":"<base64-pkcs8-private-key>"}

# 采集器配置：定时表达式使用 cron 格式，锁超时单位为毫秒
COLLECTOR_TEMP_DIR=.collector
COLLECTOR_CRON_SCHEDULE=0 */4 * * *
COLLECTOR_CONCURRENCY=2
COLLECTOR_LOCK_TIMEOUT=7200000
COLLECTOR_TRANSACTION_RETRIES=3
COLLECTOR_RETRY_BASE_DELAY=50
METRICS_TEAM_CACHE_TTL_MS=60000
METRICS_RESULT_CACHE_TTL_MS=15000
METRICS_PERCENTILE_MAX_ROWS=100000
# 性能验收脚本（只读/无持久写入）
METRICS_BENCHMARK_ROWS=1000000
METRICS_BENCHMARK_MAX_MS=10000
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_CONFIRMATION=
RETENTION_CRON_SCHEDULE=30 2 * * *

# 外部组织 adapter：凭证仅由服务端读取，禁止写入前端环境变量
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
WECOM_CORP_ID=
WECOM_CORP_SECRET=

# 跨域配置：多个前端地址可使用英文逗号分隔
# production 必须使用显式非本地 HTTP(S) origin
CORS_ORIGIN=http://localhost:3000

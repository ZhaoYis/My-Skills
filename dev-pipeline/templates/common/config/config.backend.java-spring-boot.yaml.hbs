language: {{language}}
schema: backend
context: |
  Project: {{projectName}}
  Project Type: Backend Service
  Tech Stack: {{techStackName}} - Java 17+, Spring Boot 3.x, Maven/Gradle
  ORM: MyBatis-Plus / JPA / JOOQ
  Testing: JUnit 5 + Mockito + Spring Boot Test + Testcontainers
  Conventions: Layered architecture (Controller -> Service -> Repository), DTO pattern
  Code Quality: Checkstyle / SpotBugs

rules:
  language:
{{#if (isLanguage "zh")}}
    - "所有文档、规格、提案、设计和任务必须使用简体中文编写"
    - "所有代码注释必须使用简体中文编写"
    - "所有 commit message 必须使用简体中文编写"
    - "所有 PR 描述和代码审查评论必须使用简体中文编写"
{{else}}
    - "All documents, specs, proposals, designs, and tasks MUST be written in English"
    - "All code comments MUST be written in English"
    - "All commit messages MUST be written in English"
    - "All PR descriptions and review comments MUST be written in English"
{{/if}}
  coding:
{{#if (isLanguage "zh")}}
    - "所有新编写的方法（method）必须包含完整的 Javadoc 注释，包括：方法功能描述、@param（每个参数的含义和约束）、@return（返回值含义）、@throws（可能抛出的异常及触发条件）"
    - "所有新编写的类（class）必须包含完整的 Javadoc 类注释，包括：类的职责说明、使用场景、@author、@since"
    - "所有新编写的接口（interface）必须包含 Javadoc 注释，说明该接口的用途和每个方法的契约"
    - "禁止提交没有注释的公开（public）方法和类"
{{else}}
    - "Every newly written method MUST include complete Javadoc comments covering: method purpose, @param (meaning and constraints of each parameter), @return (return value semantics), @throws (possible exceptions and trigger conditions)"
    - "Every newly written class MUST include complete Javadoc class comments covering: class responsibility, usage scenarios, @author, @since"
    - "Every newly written interface MUST include Javadoc comments explaining the interface purpose and each method's contract"
    - "Public methods and classes without comments MUST NOT be committed"
{{/if}}
  proposal:
    - "Must include API contract changes (endpoints, request/response DTOs)"
    - "Must specify database migration strategy (Flyway/Liquibase)"
  specs:
    - "Use Given/When/Then format for API behavior scenarios"
  design:
    - "Must include ERD or data model changes"
    - "Must specify middleware/interceptor chain changes"

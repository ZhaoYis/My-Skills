{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "type", "status", "title", "scope", "statement", "tags", "confidence",
    "owners", "capturedBy", "createdAt", "updatedAt", "sources", "relatedChanges",
    "relatedEntries"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^KB-[0-9]{4,}$" },
    "type": { "enum": ["fact", "constraint", "assumption", "question", "decision"] },
    "status": { "enum": ["draft", "confirmed", "deprecated", "rejected"] },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(project|team|service:[a-z0-9-]+|change:[a-z0-9-]+)$" } },
    "statement": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "feature"],
      "properties": {
        "domain": { "type": "string" },
        "feature": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "capturedBy": { "type": "string", "minLength": 1 },
    "reviewedBy": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" } },
    "relatedChanges": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^change:[a-z0-9-]+$" } },
    "relatedEntries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^KB-[0-9]{4,}$" } },
    "conflict": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^KB-[0-9]{4,}$" } },
    "supersedes": { "type": ["string", "null"], "pattern": "^KB-[0-9]{4,}$" },
    "supersededBy": { "type": ["string", "null"], "pattern": "^KB-[0-9]{4,}$" }
  }
}

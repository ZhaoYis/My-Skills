{
  "name": "opsx-dev-pipeline",
  "version": "0.2.15",
  "description": "One-stop dev pipeline initializer with AI tool adapters for skills and commands templates.",
  "author": "ZhaoYis",
  "type": "module",
  "bin": {
    "opsx-dev-pipeline": "dist/bin/opsx-dev-pipeline.js",
    "create-opsx-dev-pipeline": "dist/bin/create-opsx-dev-pipeline.js"
  },
  "files": [
    "dist",
    "config",
    "templates",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "openspec",
    "ai-workflow",
    "claude-code",
    "cursor",
    "skills",
    "dev-pipeline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhaoYis/My-Skills.git",
    "directory": "dev-pipeline"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/opsx-dev-pipeline.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test",
    "test:watch": "vitest",
    "metrics:acceptance": "node scripts/metrics-acceptance.mjs",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run",
    "init:smoke": "tsx src/bin/opsx-dev-pipeline.ts init --tool claude --stack backend --yes --dry-run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint src test test-pipeline/src test-pipeline/scenarios",
    "test:pipeline": "npm --prefix test-pipeline test",
    "lint:fix": "biome check --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "fs-extra": "^11.3.2",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.6.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@fission-ai/openspec": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^24.0.1",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "opsxDevPipeline": {
    "schemaVersion": 1,
    "projectName": "dev-pipeline",
    "tool": "claude",
    "stack": "backend",
    "language": "zh",
    "scope": "project",
    "features": [
      "base",
      "skills",
      "commands",
      "docs"
    ],
    "templateVersion": "0.2.15",
    "packageName": "opsx-dev-pipeline",
    "managedAssets": [
      {
        "id": "common-readme",
        "destination": "README.md"
      },
      {
        "id": "common-gitignore",
        "destination": ".gitignore"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:SKILL.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/SKILL.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/archive.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/archive.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/change-status.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/change-status.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/instructions-apply.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/instructions-apply.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/instructions.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/instructions.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/list-changes.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/list-changes.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/load-phase.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/load-phase.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/new-change.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/new-change.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/preflight.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/preflight.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/validate-all.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/validate-all.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/validate-change.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/validate-change.mjs"
      },
      {
        "id": "dev-spec-design-skill-bundle:SKILL.md.hbs",
        "destination": ".claude/skills/dev-spec-design/SKILL.md"
      },
      {
        "id": "dev-spec-design-skill-bundle:references/system-analysis-design-template-lite.md",
        "destination": ".claude/skills/dev-spec-design/references/system-analysis-design-template-lite.md"
      },
      {
        "id": "dev-spec-design-skill-bundle:agents/openai.yaml",
        "destination": ".claude/skills/dev-spec-design/agents/openai.yaml"
      },
      {
        "id": "opsx-dev-pipeline-command",
        "destination": ".claude/commands/opsx-dev-pipeline.md"
      },
      {
        "id": "opsx-dev-spec-design-command",
        "destination": ".claude/commands/opsx/dev-spec-design.md"
      },
      {
        "id": "claude-docs",
        "destination": "CLAUDE.md"
      },
      {
        "id": "stack-config",
        "destination": "openspec/config.yaml"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:agents/openai.yaml",
        "destination": ".claude/skills/opsx-dev-pipeline/agents/openai.yaml"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-0-entrance.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-0-entrance.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-1-propose.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-1-propose.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-2-apply.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-2-apply.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-3-review.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-3-review.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-4-unit-tests.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-4-unit-tests.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-5-archive.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-5-archive.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-6-commit-push.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-6-commit-push.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:references/phase-7-merge-deliver.md.hbs",
        "destination": ".claude/skills/opsx-dev-pipeline/references/phase-7-merge-deliver.md"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/dev-pipeline-state.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/dev-pipeline-state.mjs"
      },
      {
        "id": "opsx-dev-pipeline-skill-bundle:scripts/pipeline-lib.mjs",
        "destination": ".claude/skills/opsx-dev-pipeline/scripts/pipeline-lib.mjs"
      }
    ]
  }
}

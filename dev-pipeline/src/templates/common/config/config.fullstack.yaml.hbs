language: {{language}}
schema: fullstack
context: |
  Project: {{projectName}}
  Project Type: Fullstack Application
  Frontend: React 18+, TypeScript, Vite, Vitest + React Testing Library, Playwright (E2E)
  Backend: Java 17+, Spring Boot 3.x, Maven/Gradle, JUnit 5 + Mockito
  Conventions: Monorepo (frontend/ + backend/), API contract-first

stack:
  id: fullstack
  languages: [typescript, java]
  services:
    - name: frontend
      path: frontend
    - name: backend
      path: backend

rules:
  language:
{{#if (isLanguage "zh")}}
    - "所有文档、规格、提案、设计和任务必须使用简体中文编写"
    - "所有代码注释必须使用简体中文编写"
    - "所有 commit message 必须使用简体中文编写"
    - "所有 PR 描述和代码审查评论必须使用简体中文编写"
{{else}}
    - "All documents, specs, proposals, designs, and tasks MUST be written in English"
    - "All code comments MUST be written in English"
    - "All commit messages MUST be written in English"
    - "All PR descriptions and review comments MUST be written in English"
{{/if}}
  coding:
{{#if (isLanguage "zh")}}
    - "【后端】所有新编写的方法（method）必须包含完整的 Javadoc 注释，包括：方法功能描述、@param、@return、@throws"
    - "【后端】所有新编写的类（class）必须包含完整的 Javadoc 类注释，包括：类的职责说明、使用场景、@author、@since"
    - "【后端】所有新编写的接口（interface）必须包含 Javadoc 注释，说明该接口的用途和每个方法的契约"
    - "【前端】所有新编写的函数/组件必须包含完整的 JSDoc 注释，包括：功能描述、@param、@returns"
    - "【前端】所有新编写的 TypeScript 接口（interface）和类型（type）必须包含注释，说明其用途和每个字段的含义"
    - "【前端】React 组件必须使用 JSDoc 或 TSDoc 注释说明组件的功能、Props 含义和使用示例"
    - "禁止提交没有注释的公开（public）方法、类、导出函数和组件"
{{else}}
    - "[Backend] Every newly written method MUST include complete Javadoc comments covering: method purpose, @param, @return, @throws"
    - "[Backend] Every newly written class MUST include complete Javadoc class comments covering: class responsibility, usage scenarios, @author, @since"
    - "[Backend] Every newly written interface MUST include Javadoc comments explaining the interface purpose and each method's contract"
    - "[Frontend] Every newly written function/component MUST include complete JSDoc comments covering: purpose, @param, @returns"
    - "[Frontend] Every newly written TypeScript interface and type MUST include comments explaining its purpose and the meaning of each field"
    - "[Frontend] React components MUST use JSDoc or TSDoc comments describing the component purpose, Props meaning, and usage examples"
    - "Public methods, classes, exported functions, and components without comments MUST NOT be committed"
{{/if}}
  proposal:
    - "Must include API contract changes (endpoints, request/response DTOs)"
    - "Must include UI/UX impact analysis for frontend changes"
    - "Must specify database migration strategy (Flyway/Liquibase) for backend changes"
  specs:
    - "Use Given/When/Then format for API behavior scenarios"
    - "Use Given/When/Then format for user interaction scenarios"
  ui_components:
    - "UI 组件库优先使用 hammer 与 @hammer/* 生态（以及现有项目中的封装组件，例如 @hammer/basic、@hammer/pro 等）；不要私自引入新的 UI 库来实现同类基础组件"
    - "非常重要：按 package.json 中 hammer / @hammer/* 的 version 选择文档站"
    - "含 qa → https://hammer.yzwqa.cn；含 stg → https://hammer-stg.yzw.cn；否则 https://hammer.yzw.cn"
    - "qa 与 stg 同时出现时用 qa"
  design:
    - "Must include component tree or ERD depending on change scope"
    - "Must specify route design and state management for frontend changes"
    - "Must specify middleware/interceptor chain for backend changes"

pipeline:
  routes:
    trivial:
      description: "无行为变化的极小变更"
      phases: [0, 2, 6]
    standard:
      description: "标准变更"
      phases: [0, 1, 2, 5, 6]
    full:
      description: "高保障变更"
      phases: [0, 1, 2, 3, 4, 5, 6, 7]

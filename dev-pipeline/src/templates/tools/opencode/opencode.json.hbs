{{!--
---
type: tool-config
tool: opencode
description: |
  Project-level OpenCode config (opencode.json).
  Registers opsx-dev-pipeline PreToolUse hooks (dangerous bash + sensitive file write).
  Generated by `opsx-dev-pipeline init`; managed by manifest — re-render via `sync` / `upgrade`.
---
--}}
{
  "$schema": "https://opencode.ai/config.json",
  "_opsxManaged": {
    "package": "{{packageName}}",
    "templateVersion": "{{templateVersion}}",
    "hooksEnabled": {{#if hooksEnabled}}true{{else}}false{{/if}}
  },
  "hooks": {
    "PreToolUse": [
{{#if hooksEnabled}}
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{{hookBlockDangerousBash}}}",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "write|edit|multi_edit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{{hookBlockSensitiveWrite}}}",
            "timeout": 5000
          }
        ]
      }
{{else}}
{{/if}}
    ]
  }
}

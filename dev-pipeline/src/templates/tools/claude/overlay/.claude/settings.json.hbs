{{!--
---
type: tool-overlay
tool: claude
description: |
  Project-level Claude Code settings.json.
  Registers opsx-dev-pipeline PreToolUse hooks (dangerous bash + sensitive file write).
  Generated by `opsx-dev-pipeline init`; managed by manifest — re-render via `sync` / `upgrade`.
---
--}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_opsxManaged": {
    "package": "{{packageName}}",
    "templateVersion": "{{templateVersion}}",
    "hooksEnabled": {{#if hooksEnabled}}true{{else}}false{{/if}}
  },
  "hooks": {
    "PreToolUse": [
{{#if hooksEnabled}}
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{skillsDir}}/opsx-dev-pipeline/scripts/hooks/block-dangerous-bash.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{skillsDir}}/opsx-dev-pipeline/scripts/hooks/block-sensitive-write.mjs",
            "timeout": 5
          }
        ]
      }
{{else}}
{{/if}}
    ]
  }
}
